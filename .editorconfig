# .editorconfig
# This file helps maintain consistent coding styles across editors and teams.
# Supports HTML, JavaScript (JS), and JSON files.
# Place this in the root of your project.

root = true

# Common settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# HTML files
[*.html]
indent_size = 2
max_line_length = 120

# JavaScript and JSON files
[*.{js,jsx,ts,tsx}]
indent_size = 2
max_line_length = 100

# JSON files specifically (stricter formatting)
[*.json]
indent_size = 2
max_line_length = 80

# Optional: Package.json can have longer lines for readability
[package.json]
max_line_length = 100

# Optional: Ignore certain generated or minified files
[*.min.js]
indent_style = ignore
insert_final_newline = ignore
trim_trailing_whitespace = ignore